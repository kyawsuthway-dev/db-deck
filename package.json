{
  "name": "db-deck",
  "displayName": "DB Deck",
  "description": "Free, open-source database explorer for VS Code. Browse local and remote databases and run SQL without leaving the editor.",
  "version": "0.1.1",
  "publisher": "kyawsuthway-dev",
  "license": "MIT",
  "icon": "media/icon.png",
  "preview": true,
  "galleryBanner": {
    "color": "#1d2747",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kyawsuthway-dev/db-deck"
  },
  "bugs": {
    "url": "https://github.com/kyawsuthway-dev/db-deck/issues"
  },
  "homepage": "https://github.com/kyawsuthway-dev/db-deck#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Data Science",
    "Other"
  ],
  "keywords": [
    "database",
    "sql",
    "sqlite",
    "postgresql",
    "mysql",
    "mariadb",
    "database client",
    "sql editor",
    "query",
    "explorer",
    "er diagram",
    "mock data",
    "ssh tunnel"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbDeck",
          "title": "DB Deck",
          "icon": "media/database.svg"
        }
      ]
    },
    "views": {
      "dbDeck": [
        {
          "id": "dbDeck.connections",
          "name": "Connections"
        },
        {
          "id": "dbDeck.savedQueries",
          "name": "Saved Queries"
        },
        {
          "id": "dbDeck.history",
          "name": "Query History"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dbDeck.connections",
        "contents": "No database connections yet.\n[Add Connection](command:dbDeck.addConnection)\nSupports SQLite, PostgreSQL, MySQL and MariaDB."
      },
      {
        "view": "dbDeck.savedQueries",
        "contents": "No saved queries yet. Keep the query of the active SQL editor here:\n[Save Query…](command:dbDeck.saveQuery)\nIn a New Query editor, Ctrl+S (Cmd+S) does the same."
      },
      {
        "view": "dbDeck.history",
        "contents": "No queries have been run in this workspace yet. Queries you run from a SQL editor appear here."
      }
    ],
    "commands": [
      { "command": "dbDeck.addConnection", "title": "Add Connection", "category": "DB Deck", "icon": "$(add)" },
      { "command": "dbDeck.removeConnection", "title": "Remove Connection", "category": "DB Deck", "icon": "$(trash)" },
      { "command": "dbDeck.refresh", "title": "Refresh", "category": "DB Deck", "icon": "$(refresh)" },
      { "command": "dbDeck.disconnect", "title": "Disconnect", "category": "DB Deck", "icon": "$(debug-disconnect)" },
      { "command": "dbDeck.newQuery", "title": "New Query", "category": "DB Deck", "icon": "$(new-file)" },
      { "command": "dbDeck.openSavedQuery", "title": "Open Query…", "category": "DB Deck", "icon": "$(folder-opened)" },
      { "command": "dbDeck.previewTable", "title": "Show Rows", "category": "DB Deck", "icon": "$(table)" },
      { "command": "dbDeck.runQuery", "title": "Run Query", "category": "DB Deck", "icon": "$(play)" },
      { "command": "dbDeck.runAll", "title": "Run All", "category": "DB Deck", "icon": "$(run-all)" },
      { "command": "dbDeck.runStatement", "title": "Run Statement", "category": "DB Deck" },
      { "command": "dbDeck.explain", "title": "Explain", "category": "DB Deck" },
      { "command": "dbDeck.explainAnalyze", "title": "Explain Analyze", "category": "DB Deck" },
      { "command": "dbDeck.explainStatement", "title": "Explain Statement", "category": "DB Deck" },
      { "command": "dbDeck.serverPanel", "title": "Server…", "category": "DB Deck" },
      { "command": "dbDeck.erDiagram", "title": "ER Diagram", "category": "DB Deck" },
      { "command": "dbDeck.compareStructure", "title": "Compare Structure…", "category": "DB Deck" },
      { "command": "dbDeck.diagramOpenRows", "title": "Open Rows", "category": "DB Deck" },
      { "command": "dbDeck.diagramDesignTable", "title": "Design Table…", "category": "DB Deck" },
      { "command": "dbDeck.diagramShowDdl", "title": "Show DDL", "category": "DB Deck" },
      { "command": "dbDeck.showDdl", "title": "Show DDL", "category": "DB Deck", "icon": "$(code)" },
      { "command": "dbDeck.generateSelect", "title": "SELECT", "category": "DB Deck" },
      { "command": "dbDeck.generateInsert", "title": "INSERT", "category": "DB Deck" },
      { "command": "dbDeck.generateUpdate", "title": "UPDATE", "category": "DB Deck" },
      { "command": "dbDeck.generateDelete", "title": "DELETE", "category": "DB Deck" },
      { "command": "dbDeck.copyName", "title": "Copy Name", "category": "DB Deck" },
      { "command": "dbDeck.copyQualifiedName", "title": "Copy Qualified Name", "category": "DB Deck" },
      { "command": "dbDeck.findObject", "title": "Find Object…", "category": "DB Deck", "icon": "$(search)" },
      { "command": "dbDeck.switchDatabase", "title": "Switch Database…", "category": "DB Deck" },
      { "command": "dbDeck.editConnection", "title": "Edit Connection…", "category": "DB Deck", "icon": "$(edit)" },
      { "command": "dbDeck.moveToFolder", "title": "Move to Folder…", "category": "DB Deck" },
      { "command": "dbDeck.renameFolder", "title": "Rename Folder…", "category": "DB Deck" },
      { "command": "dbDeck.newTable", "title": "New Table…", "category": "DB Deck", "icon": "$(add)" },
      { "command": "dbDeck.designTable", "title": "Design Table…", "category": "DB Deck" },
      { "command": "dbDeck.renameTable", "title": "Rename Table…", "category": "DB Deck" },
      { "command": "dbDeck.truncateTable", "title": "Truncate Table…", "category": "DB Deck" },
      { "command": "dbDeck.dropTable", "title": "Drop…", "category": "DB Deck" },
      { "command": "dbDeck.dumpDatabase", "title": "Dump to SQL File…", "category": "DB Deck" },
      { "command": "dbDeck.dumpTable", "title": "Dump Table to SQL File…", "category": "DB Deck" },
      { "command": "dbDeck.importCsv", "title": "Import CSV…", "category": "DB Deck" },
      { "command": "dbDeck.importCsvFile", "title": "Import CSV into Table…", "category": "DB Deck" },
      { "command": "dbDeck.generateMockData", "title": "Generate Mock Data…", "category": "DB Deck" },
      { "command": "dbDeck.runSqlFile", "title": "Run SQL File…", "category": "DB Deck", "icon": "$(run-all)" },
      { "command": "dbDeck.openEnvFile", "title": "Open Source File", "category": "DB Deck", "icon": "$(go-to-file)" },
      { "command": "dbDeck.saveAsConnection", "title": "Save as Connection…", "category": "DB Deck" },
      { "command": "dbDeck.toggleEnvReadOnly", "title": "Toggle Read-only", "category": "DB Deck" },
      { "command": "dbDeck.saveQuery", "title": "Save Query…", "category": "DB Deck", "icon": "$(bookmark)" },
      { "command": "dbDeck.runSavedQuery", "title": "Run", "category": "DB Deck", "icon": "$(play)" },
      { "command": "dbDeck.renameSavedQuery", "title": "Rename…", "category": "DB Deck" },
      { "command": "dbDeck.deleteSavedQuery", "title": "Delete", "category": "DB Deck", "icon": "$(trash)" },
      { "command": "dbDeck.refreshSavedQueries", "title": "Refresh", "category": "DB Deck", "icon": "$(refresh)" },
      { "command": "dbDeck.openHistoryEntry", "title": "Open in Editor", "category": "DB Deck" },
      { "command": "dbDeck.runHistoryEntry", "title": "Run Again", "category": "DB Deck", "icon": "$(play)" },
      { "command": "dbDeck.copyHistorySql", "title": "Copy SQL", "category": "DB Deck" },
      { "command": "dbDeck.deleteHistoryEntry", "title": "Delete", "category": "DB Deck" },
      { "command": "dbDeck.searchHistory", "title": "Search Query History", "category": "DB Deck", "icon": "$(search)" },
      { "command": "dbDeck.clearHistory", "title": "Clear Query History", "category": "DB Deck", "icon": "$(clear-all)" },
      { "command": "dbDeck.selectConnection", "title": "Select Connection for This Editor", "category": "DB Deck", "icon": "$(database)" },
      { "command": "dbDeck.copySelection", "title": "Copy", "category": "DB Deck" },
      { "command": "dbDeck.copySelectionWithHeaders", "title": "Copy with Headers", "category": "DB Deck" },
      { "command": "dbDeck.copySelectionAsCsv", "title": "Copy as CSV", "category": "DB Deck" },
      { "command": "dbDeck.copySelectionAsJson", "title": "Copy as JSON", "category": "DB Deck" },
      { "command": "dbDeck.setNull", "title": "Set to NULL", "category": "DB Deck" },
      { "command": "dbDeck.deleteRows", "title": "Delete Rows", "category": "DB Deck" },
      { "command": "dbDeck.addRow", "title": "Add Row", "category": "DB Deck" },
      { "command": "dbDeck.hideColumn", "title": "Hide Column", "category": "DB Deck" }
    ],
    "submenus": [
      { "id": "dbDeck.generateSql", "label": "Generate SQL" }
    ],
    "menus": {
      "view/title": [
        { "command": "dbDeck.addConnection", "when": "view == dbDeck.connections", "group": "navigation@1" },
        { "command": "dbDeck.newQuery", "when": "view == dbDeck.connections", "group": "navigation@2" },
        { "command": "dbDeck.refresh", "when": "view == dbDeck.connections", "group": "navigation@3" },
        { "command": "dbDeck.findObject", "when": "view == dbDeck.connections", "group": "navigation@4" },
        { "command": "dbDeck.saveQuery", "when": "view == dbDeck.savedQueries", "group": "navigation@1" },
        { "command": "dbDeck.refreshSavedQueries", "when": "view == dbDeck.savedQueries", "group": "navigation@2" },
        { "command": "dbDeck.searchHistory", "when": "view == dbDeck.history", "group": "navigation@1" },
        { "command": "dbDeck.clearHistory", "when": "view == dbDeck.history", "group": "navigation@2" }
      ],
      "view/item/context": [
        { "command": "dbDeck.newQuery", "when": "view == dbDeck.connections && viewItem =~ /^connection(\\.connected)?(\\.env)?$/", "group": "inline@0" },
        { "command": "dbDeck.disconnect", "when": "view == dbDeck.connections && viewItem =~ /^connection\\.connected/", "group": "inline@1" },
        { "command": "dbDeck.editConnection", "when": "view == dbDeck.connections && viewItem =~ /^connection(\\.connected)?(\\.server)?$/", "group": "inline@2" },
        { "command": "dbDeck.refresh", "when": "view == dbDeck.connections && viewItem =~ /^connection/", "group": "inline@3" },
        { "command": "dbDeck.newQuery", "when": "view == dbDeck.connections && viewItem =~ /^(database|schema\\.database(\\.system)?)$/", "group": "inline@1" },
        { "command": "dbDeck.openSavedQuery", "when": "view == dbDeck.connections && viewItem =~ /^(database|schema\\.database(\\.system)?)$/", "group": "inline@2" },
        { "command": "dbDeck.newQuery", "when": "view == dbDeck.connections && viewItem =~ /^(database|schema\\.database(\\.system)?)$/", "group": "1_query@1" },
        { "command": "dbDeck.openSavedQuery", "when": "view == dbDeck.connections && viewItem =~ /^(database|schema\\.database(\\.system)?)$/", "group": "1_query@2" },
        { "command": "dbDeck.newQuery", "when": "view == dbDeck.connections && viewItem =~ /^connection/", "group": "1_query@1" },
        { "command": "dbDeck.refresh", "when": "view == dbDeck.connections && viewItem =~ /^connection/", "group": "2_manage@1" },
        { "command": "dbDeck.disconnect", "when": "view == dbDeck.connections && viewItem =~ /^connection\\.connected/", "group": "2_manage@2" },
        { "command": "dbDeck.switchDatabase", "when": "view == dbDeck.connections && viewItem =~ /^connection.*\\.server$/", "group": "2_manage@3" },
        { "command": "dbDeck.serverPanel", "when": "view == dbDeck.connections && viewItem =~ /^connection/", "group": "2_manage@3" },
        { "command": "dbDeck.editConnection", "when": "view == dbDeck.connections && viewItem =~ /^connection(\\.connected)?(\\.server)?$/", "group": "2_manage@4" },
        { "command": "dbDeck.moveToFolder", "when": "view == dbDeck.connections && viewItem =~ /^connection(\\.connected)?(\\.server)?$/", "group": "2_manage@5" },
        { "command": "dbDeck.renameFolder", "when": "view == dbDeck.connections && viewItem == folder", "group": "2_manage@1" },
        { "command": "dbDeck.openEnvFile", "when": "view == dbDeck.connections && viewItem == envGroup", "group": "inline@1" },
        { "command": "dbDeck.openEnvFile", "when": "view == dbDeck.connections && (viewItem == envGroup || viewItem =~ /\\.env$/)", "group": "2_manage@6" },
        { "command": "dbDeck.saveAsConnection", "when": "view == dbDeck.connections && viewItem =~ /\\.env$/", "group": "2_manage@7" },
        { "command": "dbDeck.toggleEnvReadOnly", "when": "view == dbDeck.connections && viewItem =~ /\\.env$/", "group": "2_manage@8" },
        { "command": "dbDeck.removeConnection", "when": "view == dbDeck.connections && viewItem =~ /^connection(\\.connected)?(\\.server)?$/", "group": "3_remove@1" },
        { "command": "dbDeck.dumpDatabase", "when": "view == dbDeck.connections && viewItem =~ /^connection/", "group": "2_transfer@1" },
        { "command": "dbDeck.newTable", "when": "view == dbDeck.connections && viewItem =~ /^connection/", "group": "2_design@1" },
        { "command": "dbDeck.newTable", "when": "view == dbDeck.connections && (viewItem =~ /^schema(\\.database)?$/ || viewItem == objects.table)", "group": "2_design@1" },
        { "command": "dbDeck.erDiagram", "when": "view == dbDeck.connections && (viewItem =~ /^connection/ || viewItem =~ /^schema(\\.database)?$/ || viewItem == objects.table)", "group": "2_design@2" },
        { "command": "dbDeck.compareStructure", "when": "view == dbDeck.connections && (viewItem =~ /^connection/ || viewItem =~ /^schema(\\.database)?$/)", "group": "2_design@3" },
        { "command": "dbDeck.newTable", "when": "view == dbDeck.connections && viewItem == objects.table", "group": "inline@1" },
        { "command": "dbDeck.designTable", "when": "view == dbDeck.connections && viewItem == table", "group": "2_design@0" },
        { "command": "dbDeck.renameTable", "when": "view == dbDeck.connections && viewItem == table", "group": "2_design@1" },
        { "command": "dbDeck.truncateTable", "when": "view == dbDeck.connections && viewItem == table", "group": "2_design@2" },
        { "command": "dbDeck.dropTable", "when": "view == dbDeck.connections && viewItem =~ /^(table|view)$/", "group": "3_remove@1" },
        { "command": "dbDeck.dumpTable", "when": "view == dbDeck.connections && viewItem == table", "group": "2_transfer@1" },
        { "command": "dbDeck.importCsv", "when": "view == dbDeck.connections && viewItem == table", "group": "2_transfer@2" },
        { "command": "dbDeck.generateMockData", "when": "view == dbDeck.connections && viewItem == table", "group": "2_transfer@3" },
        { "command": "dbDeck.previewTable", "when": "view == dbDeck.connections && viewItem =~ /^(table|view)(\\.system)?$/", "group": "inline@1" },
        { "command": "dbDeck.previewTable", "when": "view == dbDeck.connections && viewItem =~ /^(table|view)(\\.system)?$/", "group": "1_query@1" },
        { "command": "dbDeck.newQuery", "when": "view == dbDeck.connections && viewItem =~ /^(table|view)(\\.system)?$/", "group": "1_query@2" },
        { "submenu": "dbDeck.generateSql", "when": "view == dbDeck.connections && viewItem =~ /^(table|view)(\\.system)?$/", "group": "1_query@3" },
        { "command": "dbDeck.showDdl", "when": "view == dbDeck.connections && viewItem =~ /^(table|view|function|procedure|sequence|index|trigger)(\\.system)?$/", "group": "1_query@4" },
        { "command": "dbDeck.refresh", "when": "view == dbDeck.connections && viewItem =~ /^(table|view)(\\.system)?$/", "group": "2_manage@1" },
        { "command": "dbDeck.copyName", "when": "view == dbDeck.connections && viewItem =~ /^(table|view|function|procedure|sequence|index|trigger|column)(\\.system)?$/", "group": "4_copy@1" },
        { "command": "dbDeck.copyQualifiedName", "when": "view == dbDeck.connections && viewItem =~ /^(table|view|function|procedure|sequence|index|trigger|column)(\\.system)?$/", "group": "4_copy@2" },
        { "command": "dbDeck.runSavedQuery", "when": "view == dbDeck.savedQueries && viewItem == savedQuery", "group": "inline@1" },
        { "command": "dbDeck.runSavedQuery", "when": "view == dbDeck.savedQueries && viewItem == savedQuery", "group": "1_query@1" },
        { "command": "dbDeck.renameSavedQuery", "when": "view == dbDeck.savedQueries && viewItem == savedQuery", "group": "2_manage@1" },
        { "command": "dbDeck.deleteSavedQuery", "when": "view == dbDeck.savedQueries && viewItem == savedQuery", "group": "3_remove@1" },
        { "command": "dbDeck.openHistoryEntry", "when": "view == dbDeck.history && viewItem =~ /^historyEntry/", "group": "1_query@1" },
        { "command": "dbDeck.runHistoryEntry", "when": "view == dbDeck.history && viewItem == historyEntry", "group": "1_query@2" },
        { "command": "dbDeck.copyHistorySql", "when": "view == dbDeck.history && viewItem =~ /^historyEntry/", "group": "2_manage@1" },
        { "command": "dbDeck.deleteHistoryEntry", "when": "view == dbDeck.history && viewItem =~ /^historyEntry/", "group": "3_remove@1" }
      ],
      "dbDeck.generateSql": [
        { "command": "dbDeck.generateSelect", "group": "1_sql@1" },
        { "command": "dbDeck.generateInsert", "when": "viewItem == table", "group": "1_sql@2" },
        { "command": "dbDeck.generateUpdate", "when": "viewItem == table", "group": "1_sql@3" },
        { "command": "dbDeck.generateDelete", "when": "viewItem == table", "group": "1_sql@4" }
      ],
      "editor/title": [
        { "command": "dbDeck.runAll", "when": "editorLangId == sql", "group": "navigation@1" },
        { "command": "dbDeck.saveQuery", "when": "editorLangId == sql", "group": "navigation@2" }
      ],
      "editor/context": [
        { "command": "dbDeck.saveQuery", "when": "editorLangId == sql", "group": "1_dbDeck@1" },
        { "command": "dbDeck.explain", "when": "editorLangId == sql", "group": "1_dbDeck@3" },
        { "command": "dbDeck.explainAnalyze", "when": "editorLangId == sql", "group": "1_dbDeck@4" },
        { "command": "dbDeck.runSqlFile", "when": "editorLangId == sql && resourceScheme == file", "group": "1_dbDeck@2" }
      ],
      "explorer/context": [
        { "command": "dbDeck.runSqlFile", "when": "resourceExtname == .sql", "group": "1_dbDeck@1" },
        { "command": "dbDeck.importCsvFile", "when": "resourceExtname =~ /^\\.(csv|tsv)$/i", "group": "1_dbDeck@2" }
      ],
      "webview/context": [
        { "command": "dbDeck.diagramOpenRows", "when": "webviewId == 'dbDeck.diagram' && webviewSection == 'table'", "group": "1_table@1" },
        { "command": "dbDeck.diagramDesignTable", "when": "webviewId == 'dbDeck.diagram' && webviewSection == 'table'", "group": "1_table@2" },
        { "command": "dbDeck.diagramShowDdl", "when": "webviewId == 'dbDeck.diagram' && webviewSection == 'table'", "group": "1_table@3" },
        { "command": "dbDeck.copySelection", "when": "webviewId == 'dbDeck.results' && webviewSection == 'grid'", "group": "1_copy@1" },
        { "command": "dbDeck.copySelectionWithHeaders", "when": "webviewId == 'dbDeck.results' && webviewSection == 'grid'", "group": "1_copy@2" },
        { "command": "dbDeck.copySelectionAsCsv", "when": "webviewId == 'dbDeck.results' && webviewSection == 'grid'", "group": "2_copyAs@1" },
        { "command": "dbDeck.copySelectionAsJson", "when": "webviewId == 'dbDeck.results' && webviewSection == 'grid'", "group": "2_copyAs@2" },
        { "command": "dbDeck.setNull", "when": "webviewId == 'dbDeck.results' && webviewSection == 'grid' && dbDeckEditable", "group": "3_edit@1" },
        { "command": "dbDeck.addRow", "when": "webviewId == 'dbDeck.results' && webviewSection == 'grid' && dbDeckEditable", "group": "3_edit@2" },
        { "command": "dbDeck.deleteRows", "when": "webviewId == 'dbDeck.results' && webviewSection == 'grid' && dbDeckEditable", "group": "3_edit@3" },
        { "command": "dbDeck.hideColumn", "when": "webviewId == 'dbDeck.results' && webviewSection == 'header'", "group": "1_columns@1" }
      ],
      "commandPalette": [
        { "command": "dbDeck.previewTable", "when": "false" },
        { "command": "dbDeck.runStatement", "when": "false" },
        { "command": "dbDeck.explainStatement", "when": "false" },
        { "command": "dbDeck.erDiagram", "when": "false" },
        { "command": "dbDeck.compareStructure", "when": "false" },
        { "command": "dbDeck.diagramOpenRows", "when": "false" },
        { "command": "dbDeck.diagramDesignTable", "when": "false" },
        { "command": "dbDeck.diagramShowDdl", "when": "false" },
        { "command": "dbDeck.serverPanel", "when": "false" },
        { "command": "dbDeck.showDdl", "when": "false" },
        { "command": "dbDeck.generateSelect", "when": "false" },
        { "command": "dbDeck.generateInsert", "when": "false" },
        { "command": "dbDeck.generateUpdate", "when": "false" },
        { "command": "dbDeck.generateDelete", "when": "false" },
        { "command": "dbDeck.copyName", "when": "false" },
        { "command": "dbDeck.copyQualifiedName", "when": "false" },
        { "command": "dbDeck.switchDatabase", "when": "false" },
        { "command": "dbDeck.renameFolder", "when": "false" },
        { "command": "dbDeck.openEnvFile", "when": "false" },
        { "command": "dbDeck.dumpDatabase", "when": "false" },
        { "command": "dbDeck.newTable", "when": "false" },
        { "command": "dbDeck.designTable", "when": "false" },
        { "command": "dbDeck.renameTable", "when": "false" },
        { "command": "dbDeck.truncateTable", "when": "false" },
        { "command": "dbDeck.dropTable", "when": "false" },
        { "command": "dbDeck.dumpTable", "when": "false" },
        { "command": "dbDeck.importCsv", "when": "false" },
        { "command": "dbDeck.generateMockData", "when": "false" },
        { "command": "dbDeck.saveAsConnection", "when": "false" },
        { "command": "dbDeck.toggleEnvReadOnly", "when": "false" },
        { "command": "dbDeck.runSavedQuery", "when": "false" },
        { "command": "dbDeck.renameSavedQuery", "when": "false" },
        { "command": "dbDeck.deleteSavedQuery", "when": "false" },
